# Environment for the Playwright e2e dev server (loaded by playwright.config.ts).
# Copy to .env.e2e (which is gitignored) and fill in. The Supabase keys come
# from `pnpm db:status` once `pnpm db:start` has the local stack running;
# they're deterministic local-dev defaults but not committed so the repo
# stays clean of `sb_secret_*` strings (GitHub push protection blocks them).

E2E_SCENEIFY_MOCK=1
SCENEIFY_API_URL=http://localhost:3001

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# `Publishable` from `pnpm db:status`
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# `Secret` from `pnpm db:status`
SUPABASE_SERVICE_ROLE_KEY=

# Stub values — Zod env schemas just need the variable shape, not a working key.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_e2estub
STRIPE_SECRET_KEY=sk_test_e2estub
STRIPE_WEBHOOK_SECRET=whsec_e2estub
STRIPE_PRO_PRICE_ID=price_e2estub

PLAN_FREE_MONTHLY_GENERATIONS=10
PLAN_FREE_WATERMARK=true
PLAN_PRO_PRICE_USD=49
PLAN_PRO_MONTHLY_GENERATIONS=200
PLAN_PRO_WATERMARK=false

MAX_RUN_IMAGES=60
RUNS_PER_MINUTE_PER_USER=3

POSTGRES_URL=postgres://postgres:postgres@127.0.0.1:54322/postgres
